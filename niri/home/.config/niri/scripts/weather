#!/usr/bin/env python3
"""Open-Meteo weather for Waybar and a GTK layer-shell forecast panel."""
import argparse
import fcntl
import html
import json
import math
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import threading
import time
from datetime import datetime
from zoneinfo import ZoneInfo

import requests

CONFIG_DIR = Path.home() / '.config/niri'
CACHE_DIR = Path(os.environ.get('XDG_CACHE_HOME', str(Path.home() / '.cache'))) / 'niri-weather'
CACHE_FILE = CACHE_DIR / 'forecast.json'


def settings():
    return json.loads((CONFIG_DIR / 'weather.json').read_text())


def condition(code, is_day=True):
    if code == 0:
        return ('' if is_day else '', 'Clear sky')
    if code in (1, 2):
        return ('' if is_day else '', 'Partly cloudy')
    if code == 3:
        return '', 'Overcast'
    if code in (45, 48):
        return '', 'Fog'
    if code in (51, 53, 55, 56, 57):
        return '', 'Drizzle'
    if code in (61, 63, 65, 66, 67, 80, 81, 82):
        return '', 'Rain'
    if code in (71, 73, 75, 77, 85, 86):
        return '', 'Snow'
    if code in (95, 96, 99):
        return '', 'Thunderstorm'
    return '', 'Weather'


def number(value, suffix=''):
    return f'{value:.0f}{suffix}' if isinstance(value, (int, float)) and math.isfinite(value) else '—'


def read_cache(config):
    try:
        cached = json.loads(CACHE_FILE.read_text())
        if cached['coordinates'] == [config['latitude'], config['longitude']]:
            return cached
    except (OSError, ValueError, KeyError, TypeError):
        pass
    return None


def validate_forecast(data):
    current = data['current']
    if not isinstance(current['temperature_2m'], (int, float)):
        raise ValueError('Current temperature is missing')
    datetime.fromisoformat(current['time'])
    int(current['weather_code'])
    for section, keys in (
        ('daily', ('weather_code', 'temperature_2m_max', 'temperature_2m_min', 'precipitation_probability_max')),
        ('hourly', ('temperature_2m', 'precipitation_probability', 'weather_code', 'is_day')),
    ):
        count = len(data[section]['time'])
        if not count or any(len(data[section][key]) != count for key in keys):
            raise ValueError('Incomplete forecast')


def weather(config, force=False):
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    with (CACHE_DIR / 'refresh.lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        cached = read_cache(config)
        if cached and not force and time.time() - cached['fetched_at'] < config['refresh_seconds']:
            return cached, None
        try:
            response = requests.get('https://api.open-meteo.com/v1/forecast', params={
                'latitude': config['latitude'], 'longitude': config['longitude'],
                'timezone': config['timezone'], 'forecast_days': 5,
                'temperature_unit': 'celsius', 'wind_speed_unit': 'kmh',
                'current': 'temperature_2m,relative_humidity_2m,apparent_temperature,is_day,precipitation,weather_code,wind_speed_10m',
                'hourly': 'temperature_2m,precipitation_probability,weather_code,is_day',
                'daily': 'weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max',
            }, timeout=(3, 8), headers={'User-Agent': 'WarmSageWeather/1.0'})
            response.raise_for_status()
            data = response.json()
            validate_forecast(data)
            cached = {'coordinates': [config['latitude'], config['longitude']],
                      'fetched_at': time.time(), 'forecast': data}
            with tempfile.NamedTemporaryFile(mode='w', dir=CACHE_DIR, delete=False) as output:
                json.dump(cached, output)
                temporary = output.name
            os.replace(temporary, CACHE_FILE)
            return cached, None
        except (requests.RequestException, ValueError, KeyError, TypeError) as error:
            print(f'Weather refresh failed: {type(error).__name__}', file=sys.stderr)
            return cached, 'Unable to refresh weather. Check your connection.'


def updated(cached, config):
    return datetime.fromtimestamp(cached['fetched_at'], ZoneInfo(config['timezone'])).strftime('%H:%M')


def bar_output(config, cached, error):
    if not cached:
        return {'text': ' —', 'tooltip': f"{html.escape(config['city'])} weather unavailable\nClick to open the weather panel; right-click to retry.", 'class': 'unavailable'}
    data = cached['forecast']
    current, daily = data['current'], data['daily']
    icon, description = condition(current['weather_code'], current.get('is_day', 1))
    stale = bool(error) or time.time() - cached['fetched_at'] > config['refresh_seconds'] * 2
    tooltip = [f"<b>{html.escape(config['city'])}, {html.escape(config['country'])}</b>",
               f"{description} · {number(current['temperature_2m'], '°C')}",
               f"Feels like {number(current.get('apparent_temperature'), '°C')} · Wind {number(current.get('wind_speed_10m'), ' km/h')}",
               f"Today: {number(daily['temperature_2m_min'][0], '°')} / {number(daily['temperature_2m_max'][0], '°')} · Rain {number(daily['precipitation_probability_max'][0], '%')}",
               f"{'Cached · ' if stale else ''}Updated {updated(cached, config)}", '',
               'Click: forecast · Right-click: refresh', 'Weather by Open-Meteo']
    icon_markup = f'<span font_family="Font Awesome 6 Free Solid" weight="heavy">{icon}</span>'
    return {'text': f"{icon_markup} {number(current['temperature_2m'], '°')}",
            'tooltip': '\n'.join(tooltip), 'class': 'stale' if stale else 'normal'}


def signal_bar():
    subprocess.run(['pkill', '-RTMIN+8', '-x', 'waybar'], check=False)


def panel(config):
    # Layer shell must load before GTK's Wayland client dependency.
    from ctypes import CDLL
    CDLL('libgtk4-layer-shell.so.0')
    import gi
    gi.require_version('Gtk', '4.0')
    gi.require_version('Gtk4LayerShell', '1.0')
    from gi.repository import Gtk, Gdk, GLib, Gtk4LayerShell

    def label(text, css_class=None, expand=False):
        widget = Gtk.Label(label=str(text), xalign=0)
        widget.set_hexpand(expand)
        if css_class:
            widget.add_css_class(css_class)
        return widget

    def box(spacing=8, vertical=False):
        return Gtk.Box(orientation=Gtk.Orientation.VERTICAL if vertical else Gtk.Orientation.HORIZONTAL, spacing=spacing)

    class WeatherPanel(Gtk.Application):
        def __init__(self):
            super().__init__(application_id='org.local.WarmSageWeather')
            self.window = None
            self.loading = False

        def do_activate(self):
            if self.window:
                self.window.close()
                return
            provider = Gtk.CssProvider()
            provider.load_from_path(str(CONFIG_DIR / 'weather.css'))
            Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            self.window = Gtk.ApplicationWindow(application=self, title='Weather · ' + config['city'])
            self.window.add_css_class('weather-window')
            self.window.set_default_size(420, -1)
            self.window.set_resizable(False)
            Gtk4LayerShell.init_for_window(self.window)
            Gtk4LayerShell.set_namespace(self.window, 'warm-sage-weather')
            Gtk4LayerShell.set_layer(self.window, Gtk4LayerShell.Layer.OVERLAY)
            Gtk4LayerShell.set_exclusive_zone(self.window, -1)
            Gtk4LayerShell.set_anchor(self.window, Gtk4LayerShell.Edge.TOP, True)
            Gtk4LayerShell.set_margin(self.window, Gtk4LayerShell.Edge.TOP, 54)
            Gtk4LayerShell.set_keyboard_mode(self.window, Gtk4LayerShell.KeyboardMode.ON_DEMAND)
            keys = Gtk.EventControllerKey()
            keys.connect('key-pressed', self.key_pressed)
            self.window.add_controller(keys)
            scroller = Gtk.ScrolledWindow()
            scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            scroller.set_max_content_height(760)
            scroller.set_propagate_natural_height(True)
            self.content = box(12, vertical=True)
            self.content.add_css_class('weather-panel')
            scroller.set_child(self.content)
            self.window.set_child(scroller)
            self.render(read_cache(config))
            self.window.present()
            self.refresh()
            GLib.timeout_add_seconds(config['refresh_seconds'], self.auto_refresh)

        def key_pressed(self, controller, keyval, keycode, state):
            if keyval == Gdk.KEY_Escape:
                self.window.close()
                return True
            return False

        def auto_refresh(self):
            self.refresh()
            return True

        def refresh(self, button=None):
            if self.loading:
                return
            self.loading = True
            self.refresh_button.set_sensitive(False)
            def worker():
                cached, error = weather(config, force=button is not None)
                GLib.idle_add(self.finished, cached, error)
            threading.Thread(target=worker, daemon=True).start()

        def finished(self, cached, error):
            self.loading = False
            if self.window and self.window.get_visible():
                self.render(cached, error)
                signal_bar()
            return False

        def render(self, cached, error=None):
            child = self.content.get_first_child()
            while child:
                next_child = child.get_next_sibling()
                self.content.remove(child)
                child = next_child
            header = box()
            titles = box(2, vertical=True)
            titles.set_hexpand(True)
            titles.append(label(config['city'], 'city'))
            titles.append(label(config['country'], 'muted'))
            header.append(titles)
            self.refresh_button = Gtk.Button.new_from_icon_name('view-refresh-symbolic')
            self.refresh_button.set_tooltip_text('Refresh weather')
            self.refresh_button.connect('clicked', self.refresh)
            header.append(self.refresh_button)
            close = Gtk.Button.new_from_icon_name('window-close-symbolic')
            close.set_tooltip_text('Close · Escape')
            close.connect('clicked', lambda button: self.window.close())
            header.append(close)
            self.content.append(header)
            if error:
                message = label(error, 'warning')
                message.set_wrap(True)
                self.content.append(message)
            if cached:
                self.forecast(cached)
            else:
                self.content.append(label('Weather unavailable' if error else 'Loading forecast…', 'muted'))
            footer = box()
            footer.append(label(f'Updated {updated(cached, config)}' if cached else 'Refreshes every 10 minutes', 'muted', True))
            footer.append(Gtk.LinkButton(uri='https://open-meteo.com/', label='Open-Meteo'))
            self.content.append(footer)

        def forecast(self, cached):
            data = cached['forecast']
            current, daily, hourly = data['current'], data['daily'], data['hourly']
            stale = time.time() - cached['fetched_at'] > config['refresh_seconds'] * 2
            if stale:
                self.content.append(label('Showing the last saved forecast', 'warning'))
            icon, description = condition(current['weather_code'], current.get('is_day', 1))
            hero = box(16)
            hero.add_css_class('current')
            hero.append(label(icon, 'hero-icon'))
            detail = box(2, vertical=True)
            detail.append(label(number(current['temperature_2m'], '°C'), 'temperature'))
            detail.append(label(description))
            detail.append(label(f"Feels like {number(current.get('apparent_temperature'), '°')} · High {number(daily['temperature_2m_max'][0], '°')} / Low {number(daily['temperature_2m_min'][0], '°')}", 'muted'))
            hero.append(detail)
            self.content.append(hero)
            metrics = box(8)
            for caption, value in [('RAIN TODAY', number(daily['precipitation_probability_max'][0], '%')),
                                   ('WIND', number(current.get('wind_speed_10m'), ' km/h')),
                                   ('HUMIDITY', number(current.get('relative_humidity_2m'), '%'))]:
                tile = box(4, vertical=True)
                tile.set_hexpand(True)
                tile.add_css_class('metric')
                tile.append(label(caption, 'caption'))
                tile.append(label(value, 'metric-value'))
                metrics.append(tile)
            self.content.append(metrics)
            self.content.append(label('NEXT HOURS', 'section-title'))
            hours = box(8)
            now = datetime.now(ZoneInfo(config['timezone'])).replace(tzinfo=None).isoformat(timespec='minutes')
            indices = [i for i, stamp in enumerate(hourly['time']) if stamp >= max(current['time'], now)][:6]
            for i in indices:
                hour = box(7, vertical=True)
                hour.set_hexpand(True)
                hour.add_css_class('hour')
                hour.append(label(datetime.fromisoformat(hourly['time'][i]).strftime('%H:%M'), 'muted'))
                hour.append(label(condition(hourly['weather_code'][i], hourly['is_day'][i])[0], 'weather-icon'))
                hour.append(label(number(hourly['temperature_2m'][i], '°')))
                hour.append(label(number(hourly['precipitation_probability'][i], '%'), 'rain'))
                hours.append(hour)
            self.content.append(hours)
            self.content.append(label('5-DAY FORECAST', 'section-title'))
            days = box(0, vertical=True)
            days.add_css_class('days')
            for i, stamp in enumerate(daily['time']):
                row = box(12)
                row.add_css_class('day')
                name = 'Today' if i == 0 else datetime.fromisoformat(stamp).strftime('%a')
                row.append(label(name, expand=True))
                row.append(label(condition(daily['weather_code'][i])[0], 'weather-icon'))
                rain = label(number(daily['precipitation_probability_max'][i], '%'), 'rain')
                rain.set_width_chars(4)
                row.append(rain)
                low = label(number(daily['temperature_2m_min'][i], '°'), 'muted')
                low.set_width_chars(3)
                row.append(low)
                high = label(number(daily['temperature_2m_max'][i], '°'))
                high.set_width_chars(3)
                row.append(high)
                days.append(row)
            self.content.append(days)

    return WeatherPanel().run([sys.argv[0]])


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    modes = parser.add_mutually_exclusive_group(required=True)
    modes.add_argument('--bar', action='store_true')
    modes.add_argument('--panel', action='store_true')
    modes.add_argument('--refresh', action='store_true')
    args = parser.parse_args()
    config = settings()
    if args.panel:
        return panel(config)
    cached, error = weather(config, force=args.refresh)
    if args.refresh:
        signal_bar()
    else:
        print(json.dumps(bar_output(config, cached, error), ensure_ascii=False))
    return 0


if __name__ == '__main__':
    sys.exit(main())
