  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#b2a496",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ceb2c1"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#bfccb4"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#b7c99a"
      }
    },
    {
      "name": "Escapes and interpolation delimiters",
      "scope": [
        "constant.character.escape",
        "punctuation.section.interpolation"
      ],
      "settings": {
        "foreground": "#bfccb4"
      }
    },
    {
      "name": "Numbers, booleans and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#d4b477"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#b7c99a"
      }
    },
    {
      "name": "Types, classes and namespaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#91a7b0"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#e8dfd1"
      }
    },
    {
      "name": "Parameters and properties",
      "scope": [
        "variable.parameter",
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#d8c8b8"
      }
    },
    {
      "name": "Language variables",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#ceb2c1"
      }
    },
    {
      "name": "Attributes and annotations",
      "scope": [
        "entity.other.attribute-name",
        "meta.annotation",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#d4b477"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#b7c99a"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#b2a496"
      }
    },
    {
      "name": "Brackets",
      "scope": [
        "punctuation.section",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#e8dfd1"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#d4b477"
      }
    },
    {
      "name": "JSON object keys",
      "scope": [
        "support.type.property-name.json",
        "support.type.property-name.jsonc"
      ],
      "settings": {
        "foreground": "#d8c8b8"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#b7c99a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#e8dfd1",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#e8dfd1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#91a7b0"
      }
    },
    {
      "name": "Markup code",
      "scope": [
        "markup.inline.raw",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#b7c99a"
      }
    },
    {
      "name": "Diff additions",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#b7c99a"
      }
    },
    {
      "name": "Diff deletions",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#c09086"
      }
    },
    {
      "name": "Diff changes",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#d4b477"
      }
    },
    {
      "name": "Invalid syntax",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#c09086"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#91a7b0",
    "type": "#91a7b0",
    "class": "#91a7b0",
    "enum": "#91a7b0",
    "interface": "#91a7b0",
    "struct": "#91a7b0",
    "typeParameter": "#91a7b0",
    "parameter": "#d8c8b8",
    "variable": "#e8dfd1",
    "property": "#d8c8b8",
    "enumMember": "#d4b477",
    "event": "#b7c99a",
    "function": "#b7c99a",
    "method": "#b7c99a",
    "macro": "#bfccb4",
    "keyword": "#ceb2c1",
    "modifier": "#ceb2c1",
    "comment": {
      "foreground": "#b2a496",
      "italic": true
    },
    "string": "#b7c99a",
    "number": "#d4b477",
    "regexp": "#d4b477",
    "operator": "#bfccb4",
    "decorator": "#d4b477",
    "*.readonly": "#d4b477",
    "*.defaultLibrary": "#91a7b0",
    "function.defaultLibrary": "#b7c99a",
    "method.defaultLibrary": "#b7c99a"
  }
}
